{
  "buildCommand": "node scripts/link-env.mjs",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" } ] },
    { "source": "/assets/images/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" } ] },
    { "source": "/assets/(css|js)/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" } ] }
  ]
}
